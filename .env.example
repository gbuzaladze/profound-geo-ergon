# Copy this file to .env for local CLI runs. Never commit the populated .env.
# The Profound API key is required for every export.
PROFOUND_API_KEY=replace_with_your_api_key

# Azure SQL (optional). CLI exports also replace tables in schema {country}.
# Username/password are for local SQL authentication. Azure Functions omits both
# and uses its managed identity.
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_USERNAME=your-username
AZURE_SQL_PASSWORD=your-password

# Citation author live lookups (Instagram Instaloader + YouTube oEmbed).
# Default is on. Set to 0 to parse authors from URLs only.
# CITATION_AUTHOR_LIVE_LOOKUP=1
# CITATION_AUTHOR_LOOKUP_DELAY_SECONDS=0.5
# After 3 consecutive Instagram failures, pause then continue (default 300s).
# CITATION_AUTHOR_INSTAGRAM_COOLDOWN_SECONDS=300
# INSTAGRAM_SESSION_FILE=
# INSTAGRAM_LOGIN_USERNAME=
